{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": "transparent",
    "title": "Gold Exploration Expenditure by State Over Time",
    "width": "container", 
    "height": 400,
    "data": {"url": "https://raw.githubusercontent.com/Shun010/FIT2179-DV2/refs/heads/main/Datasets/aus_exploration_expenditure.csv"},
    "mark": "area",
    "encoding": {
        "x": {
            "timeUnit": "yearmonth", "field": "date",
            "axis": {"format": "%Y"},
            "title": "Year"
        },
        "y": {
            "aggregate": "sum", 
            "field": "expenditure",
            "title": "Expenditure (A$ Million)"
        },
        "color": {
            "field": "State",
            "scale": {
                "domain": ["Western Australia", "Queensland", "New South Wales", "Victoria", "Northern Territory", "South Australia", "Tasmania"],
                "range": ["#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7"]
            },
            "legend": {"title": "State"}
        }
    }
}