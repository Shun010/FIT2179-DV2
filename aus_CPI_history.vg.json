{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
     "background": "transparent",
    "title": "The Consumer Price Index from 1850 to 1890",
    "width": "container",
     "height": 280,
    "data": {"url": "https://raw.githubusercontent.com/Shun010/FIT2179-DV2/refs/heads/main/Datasets/AUS_CPI_1789-2025.csv"},
    "transform": [
        {"filter": "datum.Year >= 1800 && datum.Year <= 1890"}
    ],
    "layer": [
        {
             "mark": "line",
            "encoding": {
                "x": {
                    "field": "Year", 
                    "type": "quantitative",
                    "axis": {
                        "format": "d",
                        "labelFlush": true
                    }
                },
                "y": {
                    "field": "The Consumer Price Index", 
                    "type": "quantitative"
                }
            }
        },
        {
            "data": {"values": [{"year": 1851, "label": "+85% rise (1851-1855)"}]},
            "mark": {"type": "text", "align": "left", "dx": 80, "dy": 0, "fontSize": 17, "color": "#D85A30", "fontStyle": "italic"},
            "encoding": {
                "x": {"field": "year", "type": "quantitative"},
                "y": {"value": 30},
                "text": {"field": "label"}
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "color": "#D85A30",
                "size": 60
            },
            "encoding": {
                "x": {"datum": 1851},
                "y": {"datum": 1.83}
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "color": "#D85A30",
                "size": 60
            },
            "encoding": {
                "x": {"datum": 1855},
                "y": {"datum": 3.39}
            }
        }
    ]
}