{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": "transparent",
    "title": "Ore Grade by Mining Era (g/t Au)",
    "width": "container",
    "height": 250,
    "data": {"url": "https://raw.githubusercontent.com/Shun010/FIT2179-DV2/refs/heads/main/Datasets/ore_grade_history.csv"},
    "mark": {
        "type": "boxplot",
        "color": "#D55E00",
        "median": {"color": "#000000"}
    },
    "encoding": {
        "x": {
            "field": "era", "type": "nominal",
            "axis": {
                "labelAngle": -45
            },
            "title": "Mining Era"
        },
        "y": {
            "field": "grade_Au",
            "type": "quantitative",
            "title": "Ore Grade (g/t Au)"
        }
    },
    "transform": [
        {"filter": "datum.grade_Au <= 30"}
    ]
}