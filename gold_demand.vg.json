{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": "transparent",
    "width": "container",
    "height": 300,
    "title": "Global Gold Demand by Sector (2010-Present)",
    "data": {"url": "https://raw.githubusercontent.com/Shun010/FIT2179-DV2/refs/heads/main/Datasets/gold_usage.csv"},
    "transform": [
        {
        "filter": "year(datum.Date) >= 2010"
        }
    ],
    "mark": "bar",
    "encoding": {
        "x": {
            "timeUnit": "yearmonth",
            "field": "Date",
            "type": "ordinal",
            "title": "Year"
        },
        "y": {
            "aggregate": "sum",
            "field": "Value",
            "type": "quantitative",
            "title": "Gold Demand (tonnes)"
        },
        "color": {
            "field": "Category",
            "type": "nominal",
            "scale": {
                "domain": ["Jewellery Fabrication", "Technology", "Investment", "Central Bank and Other Institutions"],
                "range": ["#E69F00", "#56B4E9", "#0072B2", "#CC79A7"]
            },
             "title": "Sector",
            "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "columns": 2
            }
        }
    }
}