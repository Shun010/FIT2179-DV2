{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": "Gold Price vs Production Volume",
  "width": "container", 
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/Shun010/FIT2179-DV2/refs/heads/main/Datasets/gold_price_production.csv"
  },
  "transform": [
    {
      "filter": {
        "timeUnit": "year",
        "field": "Date",
        "range": [2000, 2025]
      }
    }
  ],
  "encoding": {
    "x": {
        "field": "Date",
        "type": "temporal",
        "timeUnit": "yearquarter",
        "axis": {"format": "%Y", "title": "Year"}
    }
  },
  "layer": [
    {
      "mark": {"stroke": "#0072B2", "type": "line", "interpolate": "monotone"},
      "encoding": {
        "y": {
          "field": "Gold Price (A$/oz)",
          "type": "quantitative",
          "title": "Gold Price (A$/oz)",
          "axis": {"titleColor":"#0072B2"}
        }
      }
    },
    {
      "mark": {"stroke": "#D55E00", "type": "line", "interpolate": "monotone"},
      "encoding": {
        "y": {
          "field": "Production Volume (t)",
          "type": "quantitative",
          "title": "Gold Production Volume (t)",
          "axis": {"titleColor":"#D55E00"}
        }
      }
    }
  ],
  "resolve": {"scale": {"y": "independent"}}
}

